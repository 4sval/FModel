<UserControl x:Class="FModel.Views.Resources.Controls.Inputs.SearchTextBox"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Panel.ZIndex="1"
              HorizontalAlignment="Left"
              Margin="5 2 0 0">
            <Viewbox Width="16"
                     Height="16">
                <Canvas Width="24"
                        Height="24">
                    <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="{StaticResource SearchIcon}" />
                </Canvas>
            </Viewbox>
        </Grid>

        <TextBox x:Name="TextBox"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 AcceptsTab="False"
                 AcceptsReturn="False"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                 Padding="25 0 0 0"
                 HorizontalAlignment="Stretch"
                 Watermark="{Binding Watermark, ElementName=Root}" />

        <Button Grid.Column="1"
                ToolTip.Tip="Clear Search Filter"
                Padding="5"
                Click="OnClearButtonClick">
            <Viewbox Width="16"
                     Height="16"
                     HorizontalAlignment="Center">
                <Canvas Width="24"
                        Height="24">
                    <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="{StaticResource BackspaceIcon}" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
