<UserControl x:Class="FModel.Views.Resources.Controls.Diff.DataDiffViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:FModel.Views.Resources.Controls"
             xmlns:diff="clr-namespace:FModel.Views.Resources.Controls.Diff"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             MinHeight="200"
             MinWidth="400"
             Background="{DynamicResource Brush.Layer1Background}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Margin="0"
            Padding="0"
            BorderBrush="{DynamicResource Brush.Layer3BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{DynamicResource Brush.Layer1Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3.75" />
                <RowDefinition Height="28.25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37*" />
                <ColumnDefinition Width="157*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="194*" />
            </Grid.ColumnDefinitions>
            <diff:DiffHeader Grid.Row="0"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"
                             Height="32"
                             Padding="8,4"
                             LeftIcon="{StaticResource DataDiffMinusIcon}"
                             RightIcon="{StaticResource DataDiffPlusIcon}"
                             Grid.RowSpan="2" />
            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2">
                <avalonedit:TextEditor x:Name="AvalonLeft"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       IsReadOnly="True"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       Padding="0"
                                       ShowLineNumbers="True"
                                       BorderThickness="0"
                                       Background="{DynamicResource Brush.Layer2Background}"
                                       Foreground="#DAE5F2" />
                <controls:AvalonSearchbar HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Margin="8"
                                          Panel.ZIndex="100"
                                          TargetEditor="{Binding ElementName=AvalonLeft}" />
            </Grid>
            <Border Grid.Row="2"
                    Grid.Column="2"
                    Background="{DynamicResource Brush.Layer3BackgroundBrush}"
                    Width="6"
                    Margin="2,0,2,0" />
            <Grid Grid.Row="2"
                  Grid.Column="3">
                <avalonedit:TextEditor x:Name="AvalonRight"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       IsReadOnly="True"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       Padding="4"
                                       ShowLineNumbers="True"
                                       BorderThickness="0"
                                       Background="{DynamicResource Brush.Layer2Background}"
                                       Foreground="#DAE5F2" />
                <controls:AvalonSearchbar HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Margin="8"
                                          Panel.ZIndex="100"
                                          TargetEditor="{Binding ElementName=AvalonRight}" />
            </Grid>
            <diff:ExpandingNavbar x:Name="DiffNavbar"
                                  Grid.Row="2"
                                  Grid.Column="3"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Stretch"
                                  Panel.ZIndex="10" />
            <Grid Grid.Row="2"
                  Grid.ColumnSpan="4"
                  VerticalAlignment="Bottom"
                  Height="48"
                  Background="{DynamicResource Brush.Layer1Background}">
                <StackPanel x:Name="LoadMorePanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource SlideUpPanelStyle}"
                            Margin="0,8">
                    <Button x:Name="LoadMoreButton"
                            Content="Load More Chunks ⟳"
                            Margin="0,0,12,0"
                            Padding="12,6"
                            FontSize="13"
                            Background="{DynamicResource {x:Static adonisUi:Brushes.Layer4BackgroundBrush}}"
                            Cursor="Hand"
                            Click="LoadMoreButton_Click" />
                </StackPanel>
            </Grid>
            <Grid x:Name="LoadingOverlay"
                  Visibility="Collapsed"
                  Background="#4D262630"
                  Grid.RowSpan="3"
                  Grid.ColumnSpan="4"
                  Panel.ZIndex="1000">
                <ContentControl ContentTemplate="{DynamicResource {x:Static adonisUi:Templates.LoadingBars}}"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
