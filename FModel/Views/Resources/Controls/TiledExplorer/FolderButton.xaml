<UserControl x:Class="FModel.Views.Resources.Controls.TiledExplorer.FolderButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="128" d:DesignWidth="128"
             d:DataContext="{d:DesignInstance Type=vm:TreeItem, IsDesignTimeCreatable=False}"
             xmlns:vm="clr-namespace:FModel.ViewModels"
             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
             Width="128" Height="128"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Ellipse Width="96"
                     Height="96">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5"
                                         Center="0.5,0.5"
                                         RadiusX="0.5"
                                         RadiusY="0.5">
                        <GradientStop Color="#33000000"
                                      Offset="0.0" />
                        <GradientStop Color="#00000000"
                                      Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Data="{Binding Header, Converter={x:Static converters:FolderToGeometryConverter.Instance}}"
                  Stretch="Uniform" Width="64" Height="64"
                  Fill="#fcbf95" />
            <Border Width="16"
                    Height="16"
                    Background="#624b39"
                    CornerRadius="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0  0 25 20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AssetsList.Assets.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding AssetsList.Assets.Count, Converter={x:Static converters:CountAssetsConverter.Instance}}"
                           Foreground="White"
                           FontSize="8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Header}"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0"
                   FontSize="10"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>

