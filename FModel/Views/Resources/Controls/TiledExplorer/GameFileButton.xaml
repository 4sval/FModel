<UserControl x:Class="FModel.Views.Resources.Controls.TiledExplorer.GameFileButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="128" d:DesignWidth="128"
             d:DataContext="{d:DesignInstance Type=vm:GameFileViewModel, IsDesignTimeCreatable=False}"

             xmlns:vm="clr-namespace:FModel.ViewModels"
             xmlns:settings="clr-namespace:FModel.Settings"
             xmlns:controls="clr-namespace:FModel.Views.Resources.Controls"
             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
             Width="128" Height="128">
    <Grid>
        <Button Padding="6"
                Background="{DynamicResource {x:Static adonisUi:Brushes.Layer0BackgroundBrush}}"
                BorderThickness="1"
                adonisExtensions:CornerRadiusExtension.CornerRadius="8"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                Click="OnFileClick"
                PreviewMouseMove="AssetsExplorerButton_PreviewMouseMove"
                MouseEnter="AssetsExplorerButton_MouseEnter"
                MouseLeave="AssetsExplorerButton_MouseLeave">
            <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Extract in New Tab"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Extract_New_Tab" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource ExtractIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Show Metadata"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Show_Metadata" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource InfoIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Decompile Blueprint"
                              IsEnabled="{Binding AssetCategory, Converter={x:Static converters:AssetTypeToBoolConverter.Instance}, ConverterParameter='Blueprint'}"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Decompile" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource CppIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="{x:Type MenuItem}"
                                   BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDecompileOption, Source={x:Static settings:UserSettings.Default}}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Header>
                            <TextBlock Text="{Binding DataContext.Asset.Extension, FallbackValue='Export Raw Data', StringFormat='Export Raw Data (.{0})', RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </MenuItem.Header>
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Export_Data" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource ExportIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save Properties (.json)"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Save_Properties" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource SaveIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save Texture"
                              IsEnabled="{Binding AssetCategory, Converter={x:Static converters:AssetTypeToBoolConverter.Instance}, ConverterParameter='Texture'}"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Save_Textures" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource TextureIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save Model"
                              IsEnabled="{Binding AssetCategory, Converter={x:Static converters:AssetTypeToBoolConverter.Instance}, ConverterParameter='Mesh'}"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Save_Models" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource ModelIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save Animation"
                              IsEnabled="{Binding AssetCategory, Converter={x:Static converters:AssetTypeToBoolConverter.Instance}, ConverterParameter='Animation'}"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Save_Animations" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource AnimationIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Save Audio"
                              IsEnabled="{Binding AssetCategory, Converter={x:Static converters:AssetTypeToBoolConverter.Instance}, ConverterParameter='Audio'}"
                              Command="{Binding PlacementTarget.Tag.RightClickMenuCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.CommandParameter>
                            <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                <Binding Source="Assets_Save_Audio" />
                                <Binding Path="DataContext"
                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                            </MultiBinding>
                        </MenuItem.CommandParameter>
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource AudioIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Copy">
                        <MenuItem.Icon>
                            <Viewbox Width="16"
                                     Height="16">
                                <Canvas Width="24"
                                        Height="24">
                                    <Path Fill="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                                          Data="{StaticResource CopyIcon}" />
                                </Canvas>
                            </Viewbox>
                        </MenuItem.Icon>
                        <MenuItem Header="Package Path"
                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                    <Binding Source="File_Path" />
                                    <Binding Path="DataContext"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="Package Name"
                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                    <Binding Source="File_Name" />
                                    <Binding Path="DataContext"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="Directory Path"
                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                    <Binding Source="Directory_Path" />
                                    <Binding Path="DataContext"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="Package Path w/o Extension"
                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                    <Binding Source="File_Path_No_Extension" />
                                    <Binding Path="DataContext"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="Package Name w/o Extension"
                                  Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{x:Static converters:MultiParameterConverter.Instance}">
                                    <Binding Source="File_Name_No_Extension" />
                                    <Binding Path="DataContext"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="96"
                      Height="96">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform" />
                    <Path Width="64"
                          Height="64"
                          Stretch="Uniform"
                          Data="{Binding IconGeometry}"
                          Fill="{Binding IconColor}"
                          Effect="{DynamicResource ShadowEffect}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
                <TextBlock Text="{Binding Asset.Name}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
        <Popup x:Name="AssetPopup"
               AllowsTransparency="True"
               Placement="AbsolutePoint"
               StaysOpen="True"
               IsOpen="False">
            <Border x:Name="PopupBorder"
                    Background="#F2202020"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <StackPanel x:Name="PopupStack">
                    <TextBlock x:Name="FileInfoTextBlock"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="White"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

