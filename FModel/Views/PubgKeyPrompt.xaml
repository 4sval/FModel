<adonisControls:AdonisWindow x:Class="FModel.Views.PubgKeyPrompt"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                             WindowStartupLocation="CenterOwner" ResizeMode="NoResize" IconVisibility="Collapsed"
                             SizeToContent="Height" ShowInTaskbar="True" Topmost="True" Width="500">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow"
               BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="PUBG Mobile Dynamic Key" />
        </Style>
    </adonisControls:AdonisWindow.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,14,18,10">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" Text="A dynamic key is required" />
            <TextBlock x:Name="DescriptionText" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="This PUBG Mobile archive uses a key slot that FModel does not have. Enter the key salt to continue. The value stays only in your local FModel settings." />
        </StackPanel>

        <GroupBox Grid.Row="1" Margin="18,4,18,18" Padding="{adonisUi:Space 0}"
                  Background="Transparent" adonisExtensions:LayerExtension.Layer="2">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Key slot" />
                <TextBlock x:Name="SlotText" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Key salt" />
                <TextBox x:Name="KeyBox" Grid.Row="2" Grid.Column="2" MaxLength="128"
                         FontFamily="Cascadia Mono, Consolas" TextChanged="OnKeyChanged"
                         adonisExtensions:WatermarkExtension.Watermark="Paste the dynamic key salt" />

                <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.Column="2" Margin="0,6,0,0"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.ErrorBrush}}"
                           Visibility="Collapsed" TextWrapping="Wrap"
                           Text="Enter a printable key salt of up to 128 characters." />
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <Grid Margin="30,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.Layer1InteractionForegroundBrush}}"
                           Text="Skip keeps FModel open; this archive will remain unavailable." />
                <Button Grid.Column="1" MinWidth="92" Margin="10,0,10,0" IsDefault="True"
                        Content="Save key" Click="OnSave" />
                <Button Grid.Column="2" MinWidth="78" IsCancel="True" Content="Skip" />
            </Grid>
        </Border>
    </Grid>
</adonisControls:AdonisWindow>
