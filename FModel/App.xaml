<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FModel.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FModel/Views/Resources/Resources.xaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FModel/Views/Resources/Colors.xaml" />
                <ResourceInclude Source="avares://FModel/Views/Resources/Icons.xaml" />
                <ResourceInclude Source="avares://FModel/Views/Resources/Controls/ContextMenus/FileContextMenu.xaml" />
                <ResourceInclude Source="avares://FModel/Views/Resources/Controls/ContextMenus/FolderContextMenu.xaml" />
                <ResourceInclude Source="avares://FModel/Views/Resources/Controls/TiledExplorer/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Accent colours preserved from original AdonisUI scheme -->
            <Color x:Key="AccentColor">#206BD4</Color>
            <SolidColorBrush x:Key="AccentColorBrush"
                             Color="{StaticResource AccentColor}" />
            <Color x:Key="AlertColor">#D49220</Color>
            <SolidColorBrush x:Key="AlertColorBrush"
                             Color="{StaticResource AlertColor}" />
            <Color x:Key="ErrorColor">#C22B2B</Color>
            <SolidColorBrush x:Key="ErrorColorBrush"
                             Color="{StaticResource ErrorColor}" />
            <!--
                WPF SystemColors aliases (M1 fix). These are stopgap values
                matching AdonisUI dark-theme equivalents; they will be replaced
                when the full resource-dictionary migration is done.
            -->
            <SolidColorBrush x:Key="SystemColors.ControlTextBrushKey"
                             Color="#E8E8E8" />
            <SolidColorBrush x:Key="SystemColors.ControlBrushKey"
                             Color="#3C3C3C" />
            <SolidColorBrush x:Key="SystemColors.AppWorkspaceBrushKey"
                             Color="#1E1E1E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
