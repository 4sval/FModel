<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FModel.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <!--
            Views/Resources/* dictionaries will be re-added here as each
            file is migrated from WPF to Avalonia XAML in later issues.
        -->
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- Accent colours preserved from original AdonisUI scheme -->
            <Color x:Key="AccentColor">#206BD4</Color>
            <SolidColorBrush x:Key="AccentColorBrush"
                             Color="{StaticResource AccentColor}" />
            <Color x:Key="AlertColor">#D49220</Color>
            <SolidColorBrush x:Key="AlertColorBrush"
                             Color="{StaticResource AlertColor}" />
            <Color x:Key="ErrorColor">#C22B2B</Color>
            <SolidColorBrush x:Key="ErrorColorBrush"
                             Color="{StaticResource ErrorColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
